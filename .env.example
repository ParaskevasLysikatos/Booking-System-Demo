# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT (optional - these are the defaults)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# Bookings (optional - these are the defaults)
BOOKING_CHECK_IN_TIME=15:00
BOOKING_GUEST_CANCELLATION_HOURS=48

# Payments - Stripe test mode (TICKET-029). Leave STRIPE_SECRET_KEY empty to
# switch payments off. Use a restricted key (rk_test_...) with only
# "Checkout Sessions: Write" and "Charges and Refunds: Write" (refunds,
# TICKET-040). STRIPE_CLI_API_KEY (full sk_test_ key) is only
# for the local stripe-cli webhook forwarder - never put it on Render.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CLI_API_KEY=
# Only needed on Render. Locally leave it unset: the stripe-cli Docker service
# writes its own secret to a shared volume (STRIPE_WEBHOOK_SECRET_FILE, set in
# docker-compose.yml) and the backend reads it from there.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional (these are the defaults):
# STRIPE_CHECKOUT_HOLD_MINUTES=30
# FRONTEND_URL=http://localhost:4200

# Emails (TICKET-030). Docker sends them to the Mailpit service (read them at
# http://localhost:8025) - nothing to set for that. To send real emails
# through Brevo instead (Render always does), set EMAIL_PROVIDER=brevo and
# BREVO_API_KEY. The sender must be an address verified in Brevo.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
DEFAULT_FROM_EMAIL=Booking System Demo <you@example.com>
# Who gets the "new booking" alert (comma-separated; empty = no alert).
BOOKING_ALERT_EMAILS=

# Postgres
POSTGRES_DB=booking_demo
POSTGRES_USER=booking_demo
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
