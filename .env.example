# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT (optional - these are the defaults)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# Bookings (optional - these are the defaults)
BOOKING_CHECK_IN_TIME=15:00
BOOKING_GUEST_CANCELLATION_HOURS=48

# Payments - Stripe test mode (TICKET-029). Leave STRIPE_SECRET_KEY empty to
# switch payments off. Use a restricted key (rk_test_...) with only
# "Checkout Sessions: Write" and "Charges and Refunds: Write" (refunds,
# TICKET-040). STRIPE_CLI_API_KEY (full sk_test_ key) is only
# for the local stripe-cli webhook forwarder - never put it on Render.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CLI_API_KEY=
# Only needed on Render. Locally leave it unset: the stripe-cli Docker service
# writes its own secret to a shared volume (STRIPE_WEBHOOK_SECRET_FILE, set in
# docker-compose.yml) and the backend reads it from there.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional (these are the defaults):
# STRIPE_CHECKOUT_HOLD_MINUTES=30
# FRONTEND_URL=http://localhost:4200

# Emails (TICKET-030). Docker sends them to the Mailpit service (read them at
# http://localhost:8025) - nothing to set for that. Render sends them through
# the Gmail API as your Gmail; to do the same from Docker set
# EMAIL_PROVIDER=gmail. The GMAIL_* values: a Google Cloud "Desktop app"
# OAuth client, and the refresh token from
#   docker compose exec backend python manage.py gmail_authorize
# (README "Emails on Render (Gmail API)"). DEFAULT_FROM_EMAIL must then be
# that same Gmail.
# EMAIL_PROVIDER=gmail
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
DEFAULT_FROM_EMAIL=Booking System Demo <you@example.com>
# Who gets the "new booking" alert and admin accounts' booking emails
# (comma-separated; empty = no alert).
BOOKING_ALERT_EMAILS=

# Postgres
POSTGRES_DB=booking_demo
POSTGRES_USER=booking_demo
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Map search - the admin form's "Find on map" (TICKET-034). OpenStreetMap
# Nominatim, Greece only, no key needed; the defaults work. Set GEOCODING_URL
# to an empty value to switch the search off (admins place the pin by hand).
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=BookingSystemDemo/1.0 (+https://github.com/ParaskevasLysikatos/Booking-System-Demo)
# GEOCODING_LANGUAGE=en
# GEOCODING_TIMEOUT=5
